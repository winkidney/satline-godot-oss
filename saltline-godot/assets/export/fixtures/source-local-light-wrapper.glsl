uniform float uDistance;uniform float uCutoff;uniform float uDecay;uniform float uAngle;
void main(){float d=max(uDistance,.000001);vec3 position=vec3(sqrt(max(0.0,1.0-uAngle*uAngle))*d,uAngle*d,0.0);PointLight point;point.position=position;point.color=vec3(.7,.4,.2);point.distance=uCutoff;point.decay=uDecay;IncidentLight p;getPointLightInfo(point,vec3(0),p);SpotLight spot;spot.position=position;spot.direction=vec3(0,1,0);spot.color=vec3(1);spot.distance=uCutoff;spot.decay=uDecay;spot.coneCos=.92;spot.penumbraCos=.97;IncidentLight s;getSpotLightInfo(spot,vec3(0),s);float attenuation=getDistanceAttenuation(uDistance,uCutoff,uDecay),cone=getSpotAttenuation(.92,.97,uAngle);gl_FragColor=gl_FragCoord.x<1.0?vec4(attenuation,p.color.r,p.visible?1.0:0.0,1.0):vec4(cone,s.color.b,s.visible?1.0:0.0,1.0);}
