extends SceneTree
func _initialize()->void:
 var source=JSON.parse_string(FileAccess.get_file_as_string("res://assets/export/scenes/main.json"))
 var low="--cold-quality=low" in OS.get_cmdline_user_args()
 if low:preload("res://scripts/cold_quality_assets.gd").apply(source,"low")
 var suffix="-low" if low else ""
 var data=JSON.parse_string(FileAccess.get_file_as_string("res://assets/export/fixtures/ground-query-reference"+suffix+".json"))
 var query=preload("res://scripts/ground_queries.gd").new(source)
 var checks=0;var maximum=0.0;var failures=[]
 var hash=HashingContext.new();hash.start(HashingContext.HASH_SHA256);hash.update(query.mask)
 checks+=1
 if hash.finish().hex_encode()!=data.mask.sha256:failures.append("mask hash")
 for row in data.rows:
  var actual=[];var expected=[]
  for channel in 4:actual.append(query.sample(row.x,row.z,channel));expected.append(row.channels[channel])
  actual.append(query.puddle_depth(row.x,row.z));expected.append(row.depth)
  actual.append(query.wetness_at(row.x,row.z));expected.append(row.wetness)
  for i in actual.size():
   checks+=1;var error=abs(float(actual[i])-float(expected[i]));maximum=maxf(maximum,error)
   if not is_finite(error) or error>1e-10:
    if failures.size()<30:failures.append({"point":[row.x,row.z],"field":i,"actual":actual[i],"expected":expected[i],"error":error})
  checks+=1
  if query.is_puddle(row.x,row.z)!=row.puddle:failures.append({"puddle":[row.x,row.z]})
 var report={"points":data.rows.size(),"checks":checks,"maximum_error":maximum,"failures":failures,"source_sha256":data.source_sha256,"methods_sha256":data.methods_sha256,"mask_sha256":data.mask.sha256,"scope":"Original Dw regenerated byte-exact versus baked uMask; literal Bg and Vg puddleDepth/isPuddle/wetnessAt, 4 channels plus boundary/interior/quay queries. No groundSurfaceAt metalRects, player events or rendered pixel proof."}
 FileAccess.open("res://evidence/ground-query-verification"+suffix+".json",FileAccess.WRITE).store_string(JSON.stringify(report,"  "));print(JSON.stringify(report));quit(0 if failures.is_empty() else 1)
