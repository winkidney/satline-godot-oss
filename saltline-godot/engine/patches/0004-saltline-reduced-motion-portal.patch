+void RendererViewport::viewport_set_source_raster_y_up(RID p_viewport, bool p_enabled) {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL(viewport);
+	if (viewport->source_raster_y_up == p_enabled) {
+		return;
+	}
+	ERR_FAIL_COND_MSG(p_enabled && OS::get_singleton()->get_current_rendering_method() != "forward_plus", "Source raster origin requires Forward+.");
+	// Fixed before first rendering; changing an active viewport would invalidate history.
+	ERR_FAIL_COND_MSG(viewport->render_buffers.is_valid(), "Set source raster origin before the viewport first renders.");
+	viewport->source_raster_y_up = p_enabled;
